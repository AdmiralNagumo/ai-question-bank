{
  "name": "question-bank-pi-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/service.test.js",
    "eval": "npm run build && node dist/src/evaluate.js",
    "eval:real": "npm run build && node --env-file-if-exists=.env dist/src/evaluate.js --real",
    "start": "node --env-file-if-exists=.env dist/src/server.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-telemetry": "0.84.1"
  }
}
