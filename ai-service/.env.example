# 仅在后端保存；与 server/.env 中 AI_SERVICE_TOKEN 相同。
AI_SERVICE_TOKEN=
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001

# 1 为离线 Mock，0 为真实模型；Mock 仍运行 Pi Agent。
AI_MOCK=1
AI_MOCK_DELAY_MS=40
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_TIMEOUT_MS=30000
AI_MAX_MODEL_CALLS=3
AI_MAX_TOOL_CALLS=6
AI_MAX_OUTPUT_TOKENS=2048
AI_CONCURRENCY=4
AI_QUEUE_LIMIT=32
AI_STATE_TTL_MS=3600000
