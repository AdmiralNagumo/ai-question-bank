# 服务端配置示例 —— C 后端通过环境变量读取配置。
# 本地开发：直接 export 对应变量，或使用默认值（见 src/config.c）。
# 生产部署：systemd 的 EnvironmentFile 加载本文件（复制为 .env 并填写真实值）。
PORT=8000
DATABASE_PATH=data/ai_question_bank.db
WEB_ROOT=../web

# 大模型 API（OpenAI 兼容协议，仅后端使用，不暴露给前端）
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Demo 账号密码（仅开发/演示用，生产环境建议移除或修改）
DEMO_ADMIN_PW=admin123
DEMO_TEACHER_PW=teacher123
DEMO_STUDENT_PW=student123

# 内部 Pi 服务；模型 API Key 配置于 ai-service/.env。
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
