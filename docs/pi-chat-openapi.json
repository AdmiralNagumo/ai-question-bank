{
  "openapi": "3.1.0",
  "info": {
    "title": "题库 Pi Agent 公共接口",
    "version": "1.3.0",
    "description": "默认teacher路由：教师自行管理一个API，学生按题目归属使用并受配额限制。前端只调用C，不接触内部凭证或完整Key。platform为显式旧版兼容。"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "本机开发；共享联调替换为后端提供的地址"
    }
  ],
  "security": [
    {
      "userBearer": []
    }
  ],
  "paths": {
    "/api/v1/chat": {
      "post": {
        "operationId": "submitChat",
        "summary": "提交解答或同题追问",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "已接受任务；保存 job_id 和 conversation_id 并开始轮询",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueuedJob"
                }
              }
            }
          },
          "400": {
            "description": "请求字段或 JSON 不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "用户登录失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "资源不可访问或已过期；AI_API_NOT_CONFIGURED表示教师未配置",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "请求方法不支持",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "对话忙、历史过长或教学模式不匹配；切换模式需新建对话；AI_CREDENTIAL_CHANGED需清除conversation_id建立新对话",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "请求超过 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "媒体类型不支持",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "内部服务响应不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "服务未配置、不可用或繁忙；AI_ACCESS_UNAVAILABLE表示权限存储故障，禁止新提交；AI_API_UNAVAILABLE / AI_CREDENTIALS_UNAVAILABLE拒绝，不回退平台Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "内部服务连接超时",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "AI_ACCESS_REQUIRED / AI_ACCESS_REVOKED / AI_ACCESS_EXPIRED：保留登录和输入，刷新权限；不自动重试POST；teacher模式为AI_API_DISABLED / AI_TEACHER_ONLY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "AI_QUOTA_EXCEEDED；Retry-After秒数，quota.reset_at由服务器提供",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaError"
                }
              }
            }
          }
        },
        "description": "teacher模式从题目teacher_id选配置并检查学生日额度，不接受客户端归属/执行配置，不叠加旧CLI授权。接收后失败/取消不退次数，超时不自动重复POST；platform模式兼容旧全局授权。"
      }
    },
    "/api/v1/chat/{job_id}": {
      "parameters": [
        {
          "in": "path",
          "name": "job_id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getChatJob",
        "summary": "查询任务；HTTP 200 后仍需检查 status",
        "responses": {
          "200": {
            "description": "任务当前状态或结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "用户登录失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "资源不可访问或已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "请求方法不支持",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "内部服务响应不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "服务未配置、不可用或繁忙",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "内部服务连接超时",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "必须有效登录且任务属于本人；AI权限撤销/到期后仍可操作本人既有任务，跨用户404。"
      },
      "delete": {
        "operationId": "cancelChatJob",
        "summary": "取消任务；已经结束则保留原结果",
        "responses": {
          "200": {
            "description": "取消后的状态或已经完成的结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "用户登录失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "资源不可访问或已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "请求方法不支持",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "内部服务响应不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "服务未配置、不可用或繁忙",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "内部服务连接超时",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "必须有效登录且任务属于本人；AI权限撤销/到期后仍可操作本人既有任务，跨用户404。"
      }
    },
    "/api/v1/ai/access": {
      "get": {
        "operationId": "getAiAccess",
        "summary": "查询当前登录用户AI使用权限",
        "description": "teacher模式先选题再查权限，返回配额，不扣次；不可用时200/allowed=false附reason_code，存储或解密失败503。platform模式沿用全局授权。",
        "responses": {
          "200": {
            "description": "Cache-Control: no-store；active仅表示授权有效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiAccessResponse"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED：重新登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED；Allow: GET",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "AI_ACCESS_UNAVAILABLE：存储故障，禁止新发送",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "QUESTION_REQUIRED / INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "QUESTION_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "AI_TEACHER_ONLY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "question_id",
            "required": false,
            "description": "默认teacher模式必填；旧platform模式不需要",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        ]
      }
    },
    "/api/v1/teacher/ai-api": {
      "get": {
        "operationId": "getTeacherApi",
        "summary": "查询自己的脱敏配置",
        "description": "仅登录teacher，归属由token确定；student/admin不可用。一个教师一条配置，无HTTP完整Key读取。",
        "responses": {
          "200": {
            "description": "Cache-Control: no-store；成功，仅脱敏配置",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeacherApiMetadata"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "TEACHER_REQUIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED；Allow: GET, PUT, PATCH",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "AI_API_UNAVAILABLE / AI_CREDENTIALS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replaceTeacherApi",
        "summary": "添加或替换自己的API并启用",
        "description": "仅登录teacher，归属由token确定；student/admin不可用。一个教师一条配置，无HTTP完整Key读取。",
        "responses": {
          "200": {
            "description": "Cache-Control: no-store；成功，仅脱敏配置",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeacherApiMetadata"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "TEACHER_REQUIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED；Allow: GET, PUT, PATCH",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "AI_API_UNAVAILABLE / AI_CREDENTIALS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST，拒绝未知/重复字段与NUL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_MEDIA_TYPE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeacherApiInput"
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "setTeacherApiEnabled",
        "summary": "启用或停用自己的API",
        "description": "仅登录teacher，归属由token确定；student/admin不可用。一个教师一条配置，无HTTP完整Key读取。",
        "responses": {
          "200": {
            "description": "Cache-Control: no-store；成功，仅脱敏配置",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeacherApiMetadata"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "TEACHER_REQUIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED；Allow: GET, PUT, PATCH",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "AI_API_UNAVAILABLE / AI_CREDENTIALS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST，拒绝未知/重复字段与NUL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_MEDIA_TYPE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "AI_API_NOT_CONFIGURED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeacherApiToggle"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque session token"
      }
    },
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "solve",
              "hint",
              "review"
            ],
            "description": "新对话省略为solve；追问省略则沿用对话模式。切换模式需新对话。"
          },
          "student_answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S",
            "description": "review每轮必填，其他模式不接受；允许只提交最终答案。"
          }
        },
        "required": [
          "question_id",
          "message"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "review"
                }
              }
            },
            "then": {
              "required": [
                "student_answer"
              ]
            }
          },
          {
            "if": {
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "solve",
                    "hint"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "student_answer"
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "student_answer"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "conversation_id"
                    ]
                  }
                ]
              }
            },
            "then": {
              "not": {}
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code"
        ]
      },
      "Usage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "model_calls": {
            "type": "integer",
            "minimum": 0
          },
          "tool_calls": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "input_tokens",
          "output_tokens",
          "model_calls",
          "tool_calls"
        ],
        "additionalProperties": false
      },
      "QueuedJob": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "question_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "status": {
            "type": "string",
            "const": "queued"
          },
          "mode": {
            "type": "string",
            "enum": [
              "solve",
              "hint",
              "review"
            ]
          },
          "hint_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "仅hint模式返回，提示层级由成功轮次决定。"
          }
        },
        "required": [
          "job_id",
          "conversation_id",
          "question_id",
          "status",
          "mode"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "hint"
                }
              }
            },
            "then": {
              "required": [
                "hint_level"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "hint_level"
                ]
              }
            }
          }
        ]
      },
      "RunningJob": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "question_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "status": {
            "type": "string",
            "const": "running"
          },
          "mode": {
            "type": "string",
            "enum": [
              "solve",
              "hint",
              "review"
            ]
          },
          "hint_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "仅hint模式返回，提示层级由成功轮次决定。"
          }
        },
        "required": [
          "job_id",
          "conversation_id",
          "question_id",
          "status",
          "mode"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "hint"
                }
              }
            },
            "then": {
              "required": [
                "hint_level"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "hint_level"
                ]
              }
            }
          }
        ]
      },
