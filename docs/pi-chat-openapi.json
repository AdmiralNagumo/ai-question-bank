{
  "openapi": "3.1.0",
  "info": {
    "title": "题库 Pi Agent 公共接口",
    "version": "1.2.0",
    "description": "前端仅调用 C 后端。POST 接受异步任务，GET 查询结果；任务失败可在 HTTP 200 中以 status=failed 返回。 所有角色默认无AI授权；前端先GET /api/v1/ai/access，POST每次仍由C检查授权。模型配置统一保存在Pi服务端。"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "本机开发；共享联调替换为后端提供的地址"
    }
  ],
  "security": [
    {
      "userBearer": []
    }
  ],
  "paths": {
    "/api/v1/chat": {
      "post": {
        "operationId": "submitChat",
        "summary": "提交解答或同题追问",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "已接受任务；保存 job_id 和 conversation_id 并开始轮询",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueuedJob"
                }
              }
            }
          },
          "400": {
            "description": "请求字段或 JSON 不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "用户登录失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "资源不可访问或已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "请求方法不支持",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "对话忙、历史过长或教学模式不匹配；切换模式需新建对话",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "请求超过 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "媒体类型不支持",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "内部服务响应不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "服务未配置、不可用或繁忙；AI_ACCESS_UNAVAILABLE表示权限存储故障，禁止新提交",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "内部服务连接超时",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "AI_ACCESS_REQUIRED / AI_ACCESS_REVOKED / AI_ACCESS_EXPIRED：保留登录和输入，刷新权限；不自动重试POST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "仅有效登录且AI授权active可提交。登录/方法检查后先检查授权，再校验请求和题目；接收层超大请求可能先413。撤销不强制杀死已有任务；不提供幂等计费或退款保证。"
      }
    },
    "/api/v1/chat/{job_id}": {
      "parameters": [
        {
          "in": "path",
          "name": "job_id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getChatJob",
        "summary": "查询任务；HTTP 200 后仍需检查 status",
        "responses": {
          "200": {
            "description": "任务当前状态或结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "用户登录失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "资源不可访问或已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "请求方法不支持",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "内部服务响应不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "服务未配置、不可用或繁忙",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "内部服务连接超时",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "必须有效登录且任务属于本人；AI权限撤销/到期后仍可操作本人既有任务，跨用户404。"
      },
      "delete": {
        "operationId": "cancelChatJob",
        "summary": "取消任务；已经结束则保留原结果",
        "responses": {
          "200": {
            "description": "取消后的状态或已经完成的结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "用户登录失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "资源不可访问或已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "请求方法不支持",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "内部服务响应不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "服务未配置、不可用或繁忙",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "内部服务连接超时",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "必须有效登录且任务属于本人；AI权限撤销/到期后仍可操作本人既有任务，跨用户404。"
      }
    },
    "/api/v1/ai/access": {
      "get": {
        "operationId": "getAiAccess",
        "summary": "查询当前登录用户AI使用权限",
        "description": "只查权限，不探测模型；禁止缓存。所有角色默认not_granted。无授权仍可查询/取消本人既有任务。",
        "responses": {
          "200": {
            "description": "Cache-Control: no-store；active仅表示授权有效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiAccessResponse"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED：重新登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED；Allow: GET",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "AI_ACCESS_UNAVAILABLE：存储故障，禁止新发送",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque session token"
      }
    },
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "solve",
              "hint",
              "review"
            ],
            "description": "新对话省略为solve；追问省略则沿用对话模式。切换模式需新对话。"
          },
          "student_answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S",
            "description": "review每轮必填，其他模式不接受；允许只提交最终答案。"
          }
        },
        "required": [
          "question_id",
          "message"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "review"
                }
              }
            },
            "then": {
              "required": [
                "student_answer"
              ]
            }
          },
          {
            "if": {
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "solve",
                    "hint"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "student_answer"
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "student_answer"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "conversation_id"
                    ]
                  }
                ]
              }
            },
            "then": {
              "not": {}
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code"
        ]
      },
      "Usage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "model_calls": {
            "type": "integer",
            "minimum": 0
          },
          "tool_calls": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "input_tokens",
          "output_tokens",
          "model_calls",
          "tool_calls"
        ],
        "additionalProperties": false
      },
      "QueuedJob": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "question_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "status": {
            "type": "string",
            "const": "queued"
          },
          "mode": {
            "type": "string",
            "enum": [
              "solve",
              "hint",
              "review"
            ]
          },
          "hint_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "仅hint模式返回，提示层级由成功轮次决定。"
          }
        },
        "required": [
          "job_id",
          "conversation_id",
          "question_id",
          "status",
          "mode"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "hint"
                }
              }
            },
            "then": {
              "required": [
                "hint_level"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "hint_level"
                ]
              }
            }
          }
        ]
      },
      "RunningJob": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "question_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "status": {
            "type": "string",
            "const": "running"
          },
          "mode": {
            "type": "string",
            "enum": [
              "solve",
              "hint",
              "review"
            ]
          },
          "hint_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "仅hint模式返回，提示层级由成功轮次决定。"
          }
        },
        "required": [
          "job_id",
          "conversation_id",
          "question_id",
          "status",
          "mode"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "hint"
                }
              }
            },
            "then": {
              "required": [
                "hint_level"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "hint_level"
                ]
              }
            }
          }
        ]
      },
      "SucceededJob": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "question_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "status": {
            "type": "string",
            "const": "succeeded"
          },
          "reply": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "mode": {
            "type": "string",
            "enum": [
              "solve",
              "hint",
              "review"
            ]
          },
          "hint_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "仅hint模式返回，提示层级由成功轮次决定。"
          }
        },
        "required": [
          "job_id",
          "conversation_id",
          "question_id",
          "status",
          "reply",
          "model",
          "usage",
          "mode"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "hint"
                }
              }
            },
            "then": {
              "required": [
                "hint_level"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "hint_level"
                ]
              }
            }
          }
        ]
      },
      "FailedJob": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "question_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "status": {
            "type": "string",
            "const": "failed"
          },
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "http_status": {
            "type": "integer",
            "enum": [
              500,
              502,
              503,
              504
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "solve",
              "hint",
              "review"
            ]
          },
          "hint_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "仅hint模式返回，提示层级由成功轮次决定。"
          }
        },
        "required": [
          "job_id",
          "conversation_id",
          "question_id",
          "status",
          "error",
          "code",
          "http_status",
          "mode"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "hint"
                }
              }
            },
            "then": {
              "required": [
                "hint_level"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "hint_level"
                ]
              }
            }
          }
        ]
      },
      "CancelledJob": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "question_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "status": {
            "type": "string",
            "const": "cancelled"
          },
          "mode": {
            "type": "string",
            "enum": [
              "solve",
              "hint",
              "review"
            ]
          },
          "hint_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "仅hint模式返回，提示层级由成功轮次决定。"
          }
        },
        "required": [
          "job_id",
          "conversation_id",
          "question_id",
          "status",
          "mode"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "hint"
                }
              }
            },
            "then": {
              "required": [
                "hint_level"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "hint_level"
                ]
              }
            }
          }
        ]
      },
      "Job": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/QueuedJob"
          },
          {
            "$ref": "#/components/schemas/RunningJob"
          },
          {
            "$ref": "#/components/schemas/SucceededJob"
          },
          {
            "$ref": "#/components/schemas/FailedJob"
          },
          {
            "$ref": "#/components/schemas/CancelledJob"
          }
        ]
      },
      "AiAccessResponse": {
        "type": "object",
        "required": [
          "ai_access"
        ],
        "additionalProperties": false,
        "properties": {
          "ai_access": {
            "$ref": "#/components/schemas/AiAccess"
          }
        }
      },
      "AiAccess": {
        "type": "object",
        "required": [
          "allowed",
          "status",
          "expires_at"
        ],
        "additionalProperties": false,
        "description": "allowed为true当且仅当status=active；expires_at为null不表示已授权。以服务器判断为准。",
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_granted",
              "active",
              "revoked",
              "expired"
            ]
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "UTC RFC3339秒精度；null为未设置，revoked可保留旧到期时间"
          }
        },
        "oneOf": [
          {
            "properties": {
              "allowed": {
                "const": true
              },
              "status": {
                "const": "active"
              }
            }
          },
          {
            "properties": {
              "allowed": {
                "const": false
              },
              "status": {
                "enum": [
                  "not_granted",
                  "revoked",
                  "expired"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
