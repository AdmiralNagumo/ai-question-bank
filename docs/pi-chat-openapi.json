      "AiAccess": {
        "type": "object",
        "required": [
          "allowed",
          "status",
          "expires_at"
        ],
        "additionalProperties": false,
        "description": "allowed为true当且仅当status=active；expires_at为null不表示已授权。以服务器判断为准。",
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_granted",
              "active",
              "revoked",
              "expired"
            ]
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "UTC RFC3339秒精度；null为未设置，revoked可保留旧到期时间"
          }
        },
        "oneOf": [
          {
            "properties": {
              "allowed": {
                "const": true
              },
              "status": {
                "const": "active"
              }
            }
          },
          {
            "properties": {
              "allowed": {
                "const": false
              },
              "status": {
                "enum": [
                  "not_granted",
                  "revoked",
                  "expired"
                ]
              }
            }
          }
        ]
      },
      "TeacherApiInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_key"
        ],
        "properties": {
          "api_key": {
            "type": "string",
            "minLength": 16,
            "maxLength": 512,
            "pattern": "^[!-~]+$",
            "writeOnly": true
          },
          "model": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:/-]+$",
            "default": "deepseek-flash"
          }
